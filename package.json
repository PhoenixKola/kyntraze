{
  "name": "kyntraze-fracture-rush",
  "version": "0.22.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck:core": "tsc -p tsconfig.core.json --pretty false",
    "test:smoke": "node scripts/core-smoke.cjs",
    "desktop:dev": "node scripts/desktop-dev.cjs",
    "desktop:build": "npm run build",
    "desktop:dist:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "desktop:pack": "npm run build && electron-builder --win dir --x64 --publish never",
    "desktop:smoke": "node scripts/desktop-smoke.cjs",
    "server": "vite-node src/server/main.ts"
  },
  "dependencies": {
    "phaser": "4.2.1",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "^22.15.30",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.1.0",
    "electron": "45.3.3",
    "electron-builder": "26.18.0",
    "typescript": "5.9.3",
    "vite": "7.1.12",
    "vitest": "3.2.4"
  },
  "description": "KYNTRAZE: FRACTURE RUSH - original sci-fi survival action game (web + Windows desktop)",
  "author": "KYNTRAZE",
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.kyntraze.fracturerush",
    "productName": "KYNTRAZE FRACTURE RUSH",
    "copyright": "KYNTRAZE (unsigned test build)",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**",
      "dist/**",
      "package.json",
      "!**/*.map"
    ],
    "asar": true,
    "compression": "normal",
    "artifactName": "KYNTRAZE-FRACTURE-RUSH-Setup-${version}.${ext}",
    "extraResources": [
      {
        "from": "LICENSE-NOTICES.md",
        "to": "LICENSE-NOTICES.md"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icons/icon.ico",
      "verifyUpdateCodeSignature": false,
      "forceCodeSigning": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "KYNTRAZE FRACTURE RUSH",
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icons/icon.ico",
      "uninstallerIcon": "build/icons/icon.ico",
      "installerHeaderIcon": "build/icons/icon.ico"
    }
  }
}
