 "layering_rules": [
  "Static draw order for every SOUTH pose (no per-pose swaps were needed in QA).",
  "At hip, knee, waist, neck base, shoulder: the PARENT/attachment piece is on top; the child's round cap hides under it.",
  "At elbow and wrist: the CHILD is on top (forearm over upper arm, hand over forearm) because forearms/hands must draw in front of the torso.",
  "Boot draws over the shin (trouser tucked into boot shaft).",
  "Upper arms draw in front of torso/collar/head/hair but UNDER their shoulder trim.",
  "All far-side limb parts draw before (behind) the matching near-side parts."
 ],
 "costume_ownership": {
  "high collar": "collar ONLY (not head, not torso)",
  "neck skin": "neck ONLY",
  "face/ears/jaw": "head",
  "hair spikes/bangs": "hair_front",
  "hair mass behind head": "hair_back",
  "jacket body, hem trim, lapels, undershirt": "torso",
  "gold/white shoulder pad": "shoulder_trim_*",
  "sleeve shoulder->elbow": "upper_arm_*",
  "sleeve end + white cuff + bare forearm + wraps": "forearm_*",
  "fist / open hand incl. knuckle wraps": "hand_*_fist / hand_*_open",
  "sash band + trouser seat/waist": "pelvis",
  "sash knot": "sash_knot",
  "sash tails": "sash_tail_a / sash_tail_b",
  "baggy trouser thigh": "thigh_*",
  "trouser below knee": "shin_*",
  "boot shaft+foot+sole": "boot_*"
 },
